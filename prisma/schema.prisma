// LÍNEA DE TIEMPO DEL PROCESO — flujo secuencial de etapas jurídicas
model ProcessTimelineStage {
    id              String        @id @default(uuid()) @map("UID_PROCESS_TIMELINE_STAGE")
    numId           Int           @default(autoincrement()) @map("NUM_ID_PROCESS_TIMELINE_STAGE")
    processId       String        @map("UID_LEGAL_PROCESS")
    firmId          String        @map("UID_FIRM")
    stage           TimelineStage @map("STR_STAGE_PROCESS_TIMELINE_STAGE")
    microStageLabel String?       @map("STR_MICRO_STAGE_LABEL_PROCESS_TIMELINE_STAGE")
    createdBy       String        @map("UID_CREATED_BY_PROCESS_TIMELINE_STAGE")
    deletedAt       DateTime?     @map("DTM_DELETED_AT_PROCESS_TIMELINE_STAGE")
    createdAt       DateTime      @default(now()) @map("DTM_CREATED_AT")
    updatedAt       DateTime      @updatedAt @map("DTM_UPDATED_AT")

    process  LegalProcess            @relation(fields: [processId], references: [id], onDelete: Cascade)
    creator  User                    @relation("ProcessTimelineStageCreator", fields: [createdBy], references: [id])
    comments ProcessTimelineComment[]

    @@index([processId])
    @@index([deletedAt])
    @@map("PROCESS_TIMELINE_STAGE")
}

// Observaciones / comentarios dentro de una etapa. Llevan fecha, responsable, adjuntos y recordatorios.
model ProcessTimelineComment {
    id            String    @id @default(uuid()) @map("UID_PROCESS_TIMELINE_COMMENT")
    numId         Int       @default(autoincrement()) @map("NUM_ID_PROCESS_TIMELINE_COMMENT")
    stageId       String    @map("UID_PROCESS_TIMELINE_STAGE")
    processId     String    @map("UID_LEGAL_PROCESS")
    body          String    @map("STR_BODY_PROCESS_TIMELINE_COMMENT")
    // Fecha y hora del EVENTO. null = el evento es el propio registro (createdAt);
    // con valor = evento futuro agendado.
    commentDate   DateTime? @map("DTM_COMMENT_DATE_PROCESS_TIMELINE_COMMENT")
    responsibleId String?   @map("UID_RESPONSIBLE_PROCESS_TIMELINE_COMMENT")
    createdBy     String    @map("UID_CREATED_BY_PROCESS_TIMELINE_COMMENT")
    deletedAt     DateTime? @map("DTM_DELETED_AT_PROCESS_TIMELINE_COMMENT")
    createdAt     DateTime  @default(now()) @map("DTM_CREATED_AT")
    updatedAt     DateTime  @updatedAt @map("DTM_UPDATED_AT")

    stage       ProcessTimelineStage       @relation(fields: [stageId], references: [id], onDelete: Cascade)
    process     LegalProcess               @relation(fields: [processId], references: [id], onDelete: Cascade)
    responsible FirmMember?                @relation("ProcessTimelineCommentResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
    creator     User                       @relation("ProcessTimelineCommentCreator", fields: [createdBy], references: [id])
    attachments ProcessTimelineAttachment[]
    reminders   ProcessTimelineReminder[]

    @@index([stageId])
    @@index([processId])
    @@index([deletedAt])
    @@map("PROCESS_TIMELINE_COMMENT")
}

model ProcessTimelineAttachment {
    id         String                        @id @default(uuid()) @map("UID_PROCESS_TIMELINE_ATTACHMENT")
    numId      Int                           @default(autoincrement()) @map("NUM_ID_PROCESS_TIMELINE_ATTACHMENT")
    commentId  String                        @map("UID_PROCESS_TIMELINE_COMMENT")
    uploadedBy String                        @map("UID_UPLOADED_BY_PROCESS_TIMELINE_ATTACHMENT")
    type       ProcessTimelineAttachmentType @default(OTHER) @map("STR_TYPE_PROCESS_TIMELINE_ATTACHMENT")
    fileKey    String                        @map("STR_FILE_KEY_PROCESS_TIMELINE_ATTACHMENT")
    fileUrl    String                        @map("STR_FILE_URL_PROCESS_TIMELINE_ATTACHMENT")
    fileName   String                        @map("STR_FILE_NAME_PROCESS_TIMELINE_ATTACHMENT")
    fileSize   Int                           @map("NUM_FILE_SIZE_PROCESS_TIMELINE_ATTACHMENT")
    mimeType   String                        @map("STR_MIME_TYPE_PROCESS_TIMELINE_ATTACHMENT")
    deletedAt  DateTime?                     @map("DTM_DELETED_AT_PROCESS_TIMELINE_ATTACHMENT")
    createdAt  DateTime                      @default(now()) @map("DTM_CREATED_AT")
    updatedAt  DateTime                      @updatedAt @map("DTM_UPDATED_AT")

    comment  ProcessTimelineComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
    uploader User                   @relation("ProcessTimelineAttachmentUploader", fields: [uploadedBy], references: [id])

    @@index([commentId])
    @@index([deletedAt])
    @@map("PROCESS_TIMELINE_ATTACHMENT")
}

model ProcessTimelineReminder {
    id             String          @id @default(uuid()) @map("UID_PROCESS_TIMELINE_REMINDER")
    numId          Int             @default(autoincrement()) @map("NUM_ID_PROCESS_TIMELINE_REMINDER")
    commentId      String          @map("UID_PROCESS_TIMELINE_COMMENT")
    processId      String          @map("UID_LEGAL_PROCESS")
    channel        ReminderChannel @default(EMAIL) @map("STR_CHANNEL_PROCESS_TIMELINE_REMINDER")
    offsetMinutes  Int             @map("NUM_OFFSET_MINUTES_PROCESS_TIMELINE_REMINDER")
    remindAt       DateTime        @map("DTM_REMIND_AT_PROCESS_TIMELINE_REMINDER")
    recipientEmail String          @map("STR_RECIPIENT_EMAIL_PROCESS_TIMELINE_REMINDER")
    status         ReminderStatus  @default(PENDING) @map("STR_STATUS_PROCESS_TIMELINE_REMINDER")
    sentAt         DateTime?       @map("DTM_SENT_AT_PROCESS_TIMELINE_REMINDER")
    lastError      String?         @map("STR_LAST_ERROR_PROCESS_TIMELINE_REMINDER")
    createdBy      String          @map("UID_CREATED_BY_PROCESS_TIMELINE_REMINDER")
    deletedAt      DateTime?       @map("DTM_DELETED_AT_PROCESS_TIMELINE_REMINDER")
    createdAt      DateTime        @default(now()) @map("DTM_CREATED_AT")
    updatedAt      DateTime        @updatedAt @map("DTM_UPDATED_AT")

    comment ProcessTimelineComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
    process LegalProcess           @relation(fields: [processId], references: [id], onDelete: Cascade)
    creator User                   @relation("ProcessTimelineReminderCreator", fields: [createdBy], references: [id])

    @@index([commentId])
    @@index([status, remindAt])
    @@index([deletedAt])
    @@map("PROCESS_TIMELINE_REMINDER")
}

// PARTICIPANTES DE HORA COMPARTIDA
model TimeEntryParticipant {
    id          String   @id @default(uuid()) @map("UID_TIME_ENTRY_PARTICIPANT")
    timeEntryId String   @map("UID_TIME_ENTRY")
    userId      String   @map("UID_USER")
    firmId      String   @map("UID_FIRM")
    createdAt   DateTime @default(now()) @map("DTM_CREATED_AT")

    timeEntry TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
    user      User      @relation("TimeEntryParticipations", fields: [userId], references: [id], onDelete: Cascade)

    @@unique([timeEntryId, userId])
    @@index([timeEntryId])
    @@index([userId])
    @@map("TIME_ENTRY_PARTICIPANT")
}

// BIBLIOTECA JURIDICA (LEGALITO RAG)
model LibraryDocument {
    id          String              @id @default(uuid()) @map("UID_LIBRARY_DOCUMENT")
    numId       Int                 @unique @default(autoincrement()) @map("NUM_ID_LIBRARY_DOCUMENT")
    firmId      String              @map("UID_FIRM")
    uploadedBy  String              @map("UID_UPLOADED_BY_LIBRARY_DOCUMENT")
    title       String              @map("STR_TITLE_LIBRARY_DOCUMENT")
    description String?             @map("STR_DESCRIPTION_LIBRARY_DOCUMENT")
    type        LibraryDocumentType @map("STR_TYPE_LIBRARY_DOCUMENT")
    fileKey     String              @map("STR_FILE_KEY_LIBRARY_DOCUMENT")
    fileUrl     String              @map("STR_FILE_URL_LIBRARY_DOCUMENT")
    fileName    String              @map("STR_FILE_NAME_LIBRARY_DOCUMENT")
    fileSize    Int                 @map("NUM_FILE_SIZE_LIBRARY_DOCUMENT")
    mimeType    String              @map("STR_MIME_TYPE_LIBRARY_DOCUMENT")
    isIndexed   Boolean             @default(false) @map("BOOL_IS_INDEXED_LIBRARY_DOCUMENT")
    branchId    String?             @map("UID_LEGAL_BRANCH_LIBRARY_DOCUMENT")
    deletedAt   DateTime?           @map("DTM_DELETED_AT_LIBRARY_DOCUMENT")
    createdAt   DateTime            @default(now()) @map("DTM_CREATED_AT")
    updatedAt   DateTime            @updatedAt @map("DTM_UPDATED_AT")

    firm     Firm           @relation(fields: [firmId], references: [id], onDelete: Cascade)
    uploader User           @relation(fields: [uploadedBy], references: [id])
    branch   LegalBranch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
    chunks   LibraryChunk[]

    @@index([firmId])
    @@index([type])
    @@index([isIndexed])
    @@index([branchId])
    @@index([deletedAt])
    @@map("LIBRARY_DOCUMENT")
}

model LibraryChunk {
    id         String                      @id @default(uuid()) @map("UID_LIBRARY_CHUNK")
    documentId String                      @map("UID_LIBRARY_DOCUMENT")
    chunkIndex Int                         @map("NUM_CHUNK_INDEX_LIBRARY_CHUNK")
    content    String                      @map("STR_CONTENT_LIBRARY_CHUNK")
    embedding  Unsupported("vector(1536)")
    createdAt  DateTime                    @default(now()) @map("DTM_CREATED_AT")

    document LibraryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

    @@index([documentId])
    @@map("LIBRARY_CHUNK")
}

// ACTUALIZACIONES LEGALES ("periodico legal") — contenido global, solo lectura
model LegalUpdate {
    id          String            @id @default(uuid()) @map("UID_LEGAL_UPDATE")
    numId       Int               @default(autoincrement()) @map("NUM_ID_LEGAL_UPDATE")
    source      LegalUpdateSource @map("STR_SOURCE_LEGAL_UPDATE")
    sourceLabel String            @map("STR_SOURCE_LABEL_LEGAL_UPDATE")
    externalId  String            @map("STR_EXTERNAL_ID_LEGAL_UPDATE")
    type        LegalUpdateType   @default(NEWS) @map("STR_TYPE_LEGAL_UPDATE")
    title       String            @map("STR_TITLE_LEGAL_UPDATE")
    summary     String?           @map("STR_SUMMARY_LEGAL_UPDATE")
    url         String            @map("STR_URL_LEGAL_UPDATE")
    category    String?           @map("STR_CATEGORY_LEGAL_UPDATE")
    branchId    String?           @map("UID_LEGAL_BRANCH_LEGAL_UPDATE")
    publishedAt DateTime          @map("DTM_PUBLISHED_AT_LEGAL_UPDATE")
    createdAt   DateTime          @default(now()) @map("DTM_CREATED_AT")
    updatedAt   DateTime          @updatedAt @map("DTM_UPDATED_AT")

    branch LegalBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

    @@unique([source, externalId])
    @@index([publishedAt])
    @@index([source])
    @@index([branchId])
    @@map("LEGAL_UPDATE")
}

// SALUD / CURSOR DE INGESTA POR FUENTE
model LegalUpdateSourceRun {
    id           String            @id @default(uuid()) @map("UID_LEGAL_UPDATE_SOURCE_RUN")
    source       LegalUpdateSource @unique @map("STR_SOURCE_LEGAL_UPDATE_SOURCE_RUN")
    lastRunAt    DateTime?         @map("DTM_LAST_RUN_AT_LEGAL_UPDATE_SOURCE_RUN")
    lastOkAt     DateTime?         @map("DTM_LAST_OK_AT_LEGAL_UPDATE_SOURCE_RUN")
    lastError    String?           @map("STR_LAST_ERROR_LEGAL_UPDATE_SOURCE_RUN")
    lastCursor   String?           @map("STR_LAST_CURSOR_LEGAL_UPDATE_SOURCE_RUN")
    itemsLastRun Int               @default(0) @map("NUM_ITEMS_LAST_RUN_LEGAL_UPDATE_SOURCE_RUN")
    createdAt    DateTime          @default(now()) @map("DTM_CREATED_AT")
    updatedAt    DateTime          @updatedAt @map("DTM_UPDATED_AT")

    @@map("LEGAL_UPDATE_SOURCE_RUN")
}

// ALMACENAMIENTO (R2) — libro mayor central del consumo por firma
enum StorageObjectArea {
    PROCESS_DOCUMENT
    TIMELINE_ATTACHMENT
    CLIENT_DOCUMENT
    LIBRARY_DOCUMENT
}

model StorageObject {
    id         String            @id @default(uuid()) @map("UID_STORAGE_OBJECT")
    numId      Int               @default(autoincrement()) @map("NUM_ID_STORAGE_OBJECT")
    firmId     String            @map("UID_FIRM")
    area       StorageObjectArea @map("STR_AREA_STORAGE_OBJECT")
    ownerType  String            @map("STR_OWNER_TYPE_STORAGE_OBJECT")
    ownerId    String            @map("STR_OWNER_ID_STORAGE_OBJECT")
    fileKey    String            @unique @map("STR_FILE_KEY_STORAGE_OBJECT")
    fileName   String            @map("STR_FILE_NAME_STORAGE_OBJECT")
    sizeBytes  Int               @map("NUM_SIZE_BYTES_STORAGE_OBJECT")
    mimeType   String            @map("STR_MIME_TYPE_STORAGE_OBJECT")
    uploadedBy String            @map("UID_UPLOADED_BY_STORAGE_OBJECT")
    deletedAt  DateTime?         @map("DTM_DELETED_AT_STORAGE_OBJECT")
    createdAt  DateTime          @default(now()) @map("DTM_CREATED_AT")
    updatedAt  DateTime          @updatedAt @map("DTM_UPDATED_AT")

    firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

    @@index([firmId, deletedAt])
    @@index([deletedAt])
    @@map("STORAGE_OBJECT")
}
