model LegalProcess {
    id          String        @id @default(uuid()) @map("UID_LEGAL_PROCESS")
    numId       Int           @unique @default(autoincrement()) @map("NUM_ID_LEGAL_PROCESS")
    firmId      String        @map("UID_FIRM")
    clientId    String        @map("UID_CLIENT")
    title       String        @map("STR_TITLE_LEGAL_PROCESS")
    description String?       @map("STR_DESCRIPTION_LEGAL_PROCESS")
    reference   String?       @map("STR_REFERENCE_LEGAL_PROCESS")
    branchId    String?       @map("UID_LEGAL_BRANCH")
    status      ProcessStatus @default(ACTIVE) @map("STR_STATUS_LEGAL_PROCESS")
    court       String?       @map("STR_COURT_LEGAL_PROCESS")
    counterpart String?       @map("STR_COUNTERPART_LEGAL_PROCESS")
    startDate   DateTime?     @map("DTM_START_DATE_LEGAL_PROCESS")
    endDate     DateTime?     @map("DTM_END_DATE_LEGAL_PROCESS")
    assignedTo            String?             @map("UID_ASSIGNED_TO_LEGAL_PROCESS")
    createdBy             String              @map("UID_CREATED_BY_LEGAL_PROCESS")
    processValue          Float?              @map("DEC_PROCESS_VALUE_LEGAL_PROCESS")
    billingType           ProcessBillingType? @map("STR_BILLING_TYPE_LEGAL_PROCESS")
    categoryId            String?             @map("UID_PROCESS_CATEGORY")
    responsiblePartnerId  String?             @map("UID_RESPONSIBLE_PARTNER_LEGAL_PROCESS")
    originatorId          String?             @map("UID_ORIGINATOR_LEGAL_PROCESS")
    billingResponsibleId  String?             @map("UID_BILLING_RESPONSIBLE_LEGAL_PROCESS")
    isProBono             Boolean             @default(false) @map("BOOL_IS_PRO_BONO_LEGAL_PROCESS")
    hasPartialPayment     Boolean             @default(false) @map("BOOL_HAS_PARTIAL_PAYMENT_LEGAL_PROCESS")
    deletedAt     DateTime?     @map("DTM_DELETED_AT_LEGAL_PROCESS")
    createdAt     DateTime      @default(now()) @map("DTM_CREATED_AT")
    updatedAt     DateTime      @updatedAt @map("DTM_UPDATED_AT")

    firm               Firm                @relation(fields: [firmId], references: [id], onDelete: Cascade)
    client             Client              @relation(fields: [clientId], references: [id])
    branch             LegalBranch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
    assignee           User?               @relation("ProcessAssignee", fields: [assignedTo], references: [id])
    creator            User                @relation("ProcessCreator", fields: [createdBy], references: [id])
    category           ProcessCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
    responsiblePartner FirmMember?         @relation("ProcessResponsiblePartner", fields: [responsiblePartnerId], references: [id], onDelete: SetNull)
    originator         FirmMember?         @relation("ProcessOriginator", fields: [originatorId], references: [id], onDelete: SetNull)
    billingResponsible FirmMember?         @relation("ProcessBillingResponsible", fields: [billingResponsibleId], references: [id], onDelete: SetNull)
    documents    Document[]
    templates    ProcessTemplate[]
    timeEntries  TimeEntry[]
    valueEntries ProcessValueEntry[]
    attachments  ProcessDocument[]
    timelineStages    ProcessTimelineStage[]
    timelineComments  ProcessTimelineComment[]
    timelineReminders ProcessTimelineReminder[]

    @@index([firmId])
    @@index([clientId])
    @@index([status])
    @@index([assignedTo])
    @@index([deletedAt])
    @@index([categoryId])
    @@index([responsiblePartnerId])
    @@map("LEGAL_PROCESS")
}

model ProcessDocument {
    id         String              @id @default(uuid()) @map("UID_PROCESS_DOCUMENT")
    numId      Int                 @default(autoincrement()) @map("NUM_ID_PROCESS_DOCUMENT")
    processId  String              @map("UID_LEGAL_PROCESS")
    uploadedBy String              @map("UID_UPLOADED_BY_PROCESS_DOCUMENT")
    type       ProcessDocumentType @map("STR_TYPE_PROCESS_DOCUMENT")
    fileKey    String              @map("STR_FILE_KEY_PROCESS_DOCUMENT")
    fileUrl    String              @map("STR_FILE_URL_PROCESS_DOCUMENT")
    fileName   String              @map("STR_FILE_NAME_PROCESS_DOCUMENT")
    fileSize   Int                 @map("NUM_FILE_SIZE_PROCESS_DOCUMENT")
    mimeType   String              @map("STR_MIME_TYPE_PROCESS_DOCUMENT")
    deletedAt  DateTime?           @map("DTM_DELETED_AT_PROCESS_DOCUMENT")
    createdAt  DateTime            @default(now()) @map("DTM_CREATED_AT")
    updatedAt  DateTime            @updatedAt @map("DTM_UPDATED_AT")

    process  LegalProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
    uploader User         @relation("ProcessDocumentUploader", fields: [uploadedBy], references: [id])

    @@index([processId])
    @@index([type])
    @@index([deletedAt])
    @@map("PROCESS_DOCUMENT")
}

model ProcessTemplate {
    id         String   @id @default(uuid()) @map("UID_PROCESS_TEMPLATE")
    processId  String   @map("UID_LEGAL_PROCESS")
    templateId String   @map("UID_DOCUMENT_TEMPLATE")
    sortOrder  Int      @default(0) @map("NUM_SORT_ORDER_PROCESS_TEMPLATE")
    isRequired Boolean  @default(false) @map("BOOL_IS_REQUIRED_PROCESS_TEMPLATE")
    createdAt  DateTime @default(now()) @map("DTM_CREATED_AT")

    process  LegalProcess     @relation(fields: [processId], references: [id], onDelete: Cascade)
    template DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

    @@unique([processId, templateId])
