model ProcessCategory {
    id        String    @id @default(uuid()) @map("UID_PROCESS_CATEGORY")
    numId     Int       @default(autoincrement()) @map("NUM_ID_PROCESS_CATEGORY")
    firmId    String?   @map("UID_FIRM")
    name      String    @map("STR_NAME_PROCESS_CATEGORY")
    slug      String    @map("STR_SLUG_PROCESS_CATEGORY")
    isSystem  Boolean   @default(false) @map("BOOL_IS_SYSTEM_PROCESS_CATEGORY")
    isActive  Boolean   @default(true) @map("BOOL_IS_ACTIVE_PROCESS_CATEGORY")
    sortOrder Int       @default(0) @map("NUM_SORT_ORDER_PROCESS_CATEGORY")
    deletedAt DateTime? @map("DTM_DELETED_AT_PROCESS_CATEGORY")
    createdAt DateTime  @default(now()) @map("DTM_CREATED_AT")
